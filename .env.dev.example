NODE_ENV=development

POSTGRES_USER=nail
POSTGRES_PASSWORD=nail
POSTGRES_DB=nail_academy
# host-порт Postgres (меняй если 5436 занят на машине)
POSTGRES_PORT=5436

# Строка для запуска С ХОСТА (npm run dev / db:push / db:seed).
# Хост-порт обязан совпадать с POSTGRES_PORT выше.
# Внутри docker-сети URL строится автоматически в docker-compose.yml (db:5432) —
# эта переменная туда НЕ передаётся.
DATABASE_URL=postgresql://nail:nail@localhost:5436/nail_academy

SESSION_SECRET=dev-session-secret-change-me
ADMIN_EMAIL=admin@nailacademy.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Admin

APP_PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

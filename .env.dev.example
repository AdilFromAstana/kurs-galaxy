NODE_ENV=development

POSTGRES_USER=nail
POSTGRES_PASSWORD=nail
POSTGRES_DB=nail_academy
# host-порт Postgres (меняй если 5434 занят на машине)
POSTGRES_PORT=5436

# app подключается к БД внутри docker-сети по имени сервиса db:5432
DATABASE_URL=postgresql://nail:nail@db:5432/nail_academy

SESSION_SECRET=dev-session-secret-change-me
ADMIN_EMAIL=admin@nailacademy.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Admin

APP_PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

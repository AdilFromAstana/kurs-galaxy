generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== Студенты =====
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchases   Purchase[]
  progress    Progress[]
  videoPos    VideoPosition[]
  lastLessons LastLesson[]
  resetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ===== Админы / преподаватели =====
model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         AdminRole @default(ADMIN)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Курсы, у которых этот админ числится автором.
  // Опционально: курс может быть и без автора (legacy / системные курсы).
  authoredCourses Course[]
}

enum AdminRole {
  ADMIN
  TEACHER
}

// ===== Каталог =====
model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Автор курса (опционально для legacy и системных курсов).
  // При удалении админа просто очищаем ссылку (SetNull), курс остаётся.
  creatorId String?
  creator   Admin?  @relation(fields: [creatorId], references: [id], onDelete: SetNull)

  modules      Module[]
  pricingPlans PricingPlan[]
  purchases    Purchase[]
  progress     Progress[]
  lastLessons  LastLesson[]
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId])
}

model Lesson {
  id        String   @id @default(cuid())
  moduleId  String
  title     String
  duration  String
  isFree    Boolean  @default(false)
  videoUrl  String
  coverUrl  String?
  content   String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  module      Module          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  materials   Material[]
  videos      LessonVideo[]
  progress    Progress[]
  videoPos    VideoPosition[]
  lastLessons LastLesson[]

  @@index([moduleId])
}

model LessonVideo {
  id        String   @id @default(cuid())
  lessonId  String
  title     String?
  url       String
  duration  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson   Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  videoPos VideoPosition[]

  @@index([lessonId])
}

model Material {
  id       String       @id @default(cuid())
  lessonId String
  title    String
  url      String
  type     MaterialType

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

enum MaterialType {
  PDF
  LINK
  PRODUCT
}

// ===== Тарифы =====
model PricingPlan {
  id            String           @id @default(cuid())
  courseId      String
  name          String
  description   String?
  accessPeriod  AccessPeriodType
  accessDays    Int? // null для UNLIMITED
  price         Int // в минимальных единицах валюты или просто целые тенге
  currency      String           @default("KZT")
  isActive      Boolean          @default(true)
  isRecommended Boolean          @default(false)
  order         Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  purchases Purchase[]

  @@index([courseId])
}

enum AccessPeriodType {
  ONE_MONTH
  TWO_MONTHS
  THREE_MONTHS
  SIX_MONTHS
  TWELVE_MONTHS
  UNLIMITED
}

// ===== Покупки =====
model Purchase {
  id              String         @id @default(cuid())
  userId          String
  courseId        String
  planId          String
  status          PurchaseStatus @default(ACTIVE)
  purchasedAt     DateTime       @default(now())
  expiresAt       DateTime?
  paymentAmount   Int
  paymentCurrency String         @default("KZT")
  paymentStatus   PaymentStatus  @default(COMPLETED)
  paymentMethod   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  plan   PricingPlan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([courseId])
}

enum PurchaseStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// ===== Прогресс =====
model Progress {
  id          String   @id @default(cuid())
  userId      String
  courseId    String
  lessonId    String
  completedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, courseId])
}

model VideoPosition {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  videoId   String?
  time      Float    @default(0)
  updatedAt DateTime @updatedAt

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  video  LessonVideo? @relation(fields: [videoId], references: [id], onDelete: SetNull)

  // Postgres считает каждый NULL уникальным — легаси-строки (videoId = null) остаются валидными
  @@unique([userId, lessonId, videoId])
}

model LastLesson {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  lessonId  String
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

// ===== Сертификаты =====
// Singleton — одна запись на платформу с id="default".
model CertificateSettings {
  id             String   @id @default("default")
  templateId     String   @default("classic-pink")
  brandName      String   @default("KursGalaxy.kz")
  brandSubtitle  String   @default("Онлайн-академия")
  titleText      String   @default("СЕРТИФИКАТ")
  subtitleText   String   @default("об успешном окончании курса")
  introText      String   @default("Настоящим удостоверяется, что")
  completedText  String   @default("успешно прошёл(а) курс")
  signaturePath  String?
  instructorName String?
  logoPath       String?
  qrEnabled      Boolean  @default(true)
  publicBaseUrl  String   @default("http://localhost:39010")
  updatedAt      DateTime @updatedAt
}

// ===== Настройки сайта =====
// Singleton — id="default". Контакты, реквизиты, тексты юр-страниц.
model SiteSettings {
  id String @id @default("default")

  // Контакты
  contactPhone     String?
  contactEmail     String?
  contactWhatsapp  String?
  contactTelegram  String?
  contactInstagram String?

  // Юридическое лицо (для оферты, чека и т.п.)
  legalEntityName   String? // "ИП Айжанов Адиль"
  legalRequisites   String? // ИИН/БИН
  legalAddress      String? // юридический адрес
  legalRegisteredAt String? // дата регистрации, опционально

  // Тексты юридических страниц (Markdown). null → используется шаблон-заглушка.
  offerText   String? // договор-оферта
  privacyText String? // политика конфиденциальности
  refundText  String? // условия возврата

  updatedAt DateTime @updatedAt
}

// Запись каждого выданного сертификата для верификации
model Certificate {
  id          String   @id // человекочитаемый ID, e.g., 20260507-HUTZ6X
  userId      String
  courseId    String
  userName    String // снимок имени пользователя на момент выдачи
  courseTitle String // снимок названия курса
  templateId  String
  issuedAt    DateTime @default(now())

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}
